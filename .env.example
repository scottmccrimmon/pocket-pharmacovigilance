# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Hugging Face Hub token (needed only if we touch a gated model/dataset)
HF_TOKEN=

# Anthropic API key (used for the B2a/B2b API comparator baselines, Section 6-7 of the brief)
ANTHROPIC_API_KEY=

# Weights & Biases — `wandb login` stores this in ~/.netrc already; only needed here
# if running non-interactively (e.g. a script that can't prompt).
WANDB_API_KEY=
WANDB_PROJECT=pocket-pharmacovigilance
